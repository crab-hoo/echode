{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/wait-for-verify.sh",
        "matcher": "Shell|Write|StrReplace|Delete|EditNotebook|Task",
        "timeout": 15600,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/check-on-stop.sh",
        "timeout": 15600,
        "failClosed": true,
        "loop_limit": 3
      }
    ]
  }
}
