      }
    },
    "Show reference notes help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Show this track as reference notes when editing another track. Editable notes stay visible." } },
        "ja": { "stringUnit": { "state": "translated", "value": "別トラックの編集中に参照ノートを表示します。編集対象のノートは常に表示します。" } }
      }
    },
    "Edit piano track help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use this track as the single piano input target without changing arrange or device selection." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アレンジやデバイスの選択を変えず、このトラックをピアノロールの入力先にします。" } }
      }
    },
    "Follow Playhead": {
