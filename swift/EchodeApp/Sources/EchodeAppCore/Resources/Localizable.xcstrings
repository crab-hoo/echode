{
  "sourceLanguage": "en",
  "strings": {
    "Auto-Mute Reason": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Muted automatically: %@ returned an invalid value. Play to unmute." } },
      "ja": { "stringUnit": { "state": "translated", "value": "自動ミュート: %@ が不正な値を返しました。再生すると解除されます。" } }
    } },
    "Master Auto-Muted": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "The master is muted automatically: the output reached %@. Play to unmute." } },
      "ja": { "stringUnit": { "state": "translated", "value": "マスターを自動ミュートしました。出力が %@ に達しました。再生すると解除されます。" } }
    } },
    "Track Auto-Muted": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "%1$@ is muted automatically: %2$@ returned an invalid value. Play to unmute." } },
      "ja": { "stringUnit": { "state": "translated", "value": "%1$@ を自動ミュートしました。%2$@ が不正な値を返しました。再生すると解除されます。" } }
    } },
    "Tracks Auto-Muted": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "%ld tracks are muted automatically: a plugin returned an invalid value. Play to unmute." } },
      "ja": { "stringUnit": { "state": "translated", "value": "%ld 本のトラックを自動ミュートしました。プラグインが不正な値を返しました。再生すると解除されます。" } }
    } },
    "Unknown Plugin": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Unknown plugin" } },
      "ja": { "stringUnit": { "state": "translated", "value": "不明なプラグイン" } }
    } },
    "Export Presets": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export Presets" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しプリセット" } }
    } },
    "Preset": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Preset" } },
      "ja": { "stringUnit": { "state": "translated", "value": "プリセット" } }
    } },
    "Choose a preset": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Choose a preset" } },
      "ja": { "stringUnit": { "state": "translated", "value": "プリセットを選択" } }
    } },
    "Apply Preset": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Apply Preset" } },
      "ja": { "stringUnit": { "state": "translated", "value": "適用" } }
    } },
    "Delete Preset": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Delete Preset" } },
      "ja": { "stringUnit": { "state": "translated", "value": "削除" } }
    } },
    "Preset name": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Preset name" } },
      "ja": { "stringUnit": { "state": "translated", "value": "プリセット名" } }
    } },
    "Save Preset": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Save Preset" } },
      "ja": { "stringUnit": { "state": "translated", "value": "保存" } }
    } },
    "Presets stay on this Mac. Applying changes only the current fields.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Presets stay on this Mac. Applying changes only the current fields." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac に保存します。適用は現在の入力欄だけを変更します。" } }
    } },
    "Export preset saved on this Mac.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export preset saved on this Mac." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac に書出しプリセットを保存しました。" } }
    } },
    "Export preset applied to the current fields.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export preset applied to the current fields." } },
      "ja": { "stringUnit": { "state": "translated", "value": "現在の入力欄に書出しプリセットを適用しました。" } }
    } },
    "Export preset deleted from this Mac.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export preset deleted from this Mac." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac の書出しプリセットを削除しました。" } }
    } },
    "Export presets cannot be read. Existing presets have not been changed.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export presets cannot be read. Existing presets have not been changed." } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しプリセットを読めません。保存済みのプリセットは変更していません。" } }
    } },
    "Enter a nonempty preset name without control characters.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Enter a nonempty preset name without control characters." } },
      "ja": { "stringUnit": { "state": "translated", "value": "制御文字を含まない、空でないプリセット名を入力してください。" } }
    } },
    "Correct the export settings before saving a preset.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Correct the export settings before saving a preset." } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出し設定を修正してからプリセットを保存してください。" } }
    } },
    "That preset name already exists. Choose another name or delete the existing preset first.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "That preset name already exists. Choose another name or delete the existing preset first." } },
      "ja": { "stringUnit": { "state": "translated", "value": "同名のプリセットがあります。別の名前にするか、既存のプリセットを先に削除してください。" } }
    } },
    "That export preset no longer exists.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "That export preset no longer exists." } },
      "ja": { "stringUnit": { "state": "translated", "value": "その書出しプリセットは既に削除されています。" } }
    } },
    "Use Default": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Use Default" } },
      "ja": { "stringUnit": { "state": "translated", "value": "既定設定を使う" } }
    } },
    "Save as Default": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Save as Default" } },
      "ja": { "stringUnit": { "state": "translated", "value": "既定設定として保存" } }
    } },
    "Reset Default": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Reset Default" } },
      "ja": { "stringUnit": { "state": "translated", "value": "既定設定を初期化" } }
    } },
    "Defaults apply on this Mac to projects without previous export settings.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Defaults apply on this Mac to projects without previous export settings." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac で、前回の書出し設定がないプロジェクトに適用します。" } }
    } },
    "Default export settings loaded.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Default export settings loaded." } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しの既定設定を読み込みました。" } }
    } },
    "Default export settings saved on this Mac.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Default export settings saved on this Mac." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac に書出しの既定設定を保存しました。" } }
    } },
    "Factory export defaults restored on this Mac.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Factory export defaults restored on this Mac." } },
      "ja": { "stringUnit": { "state": "translated", "value": "この Mac の書出しの既定設定を初期化しました。" } }
    } },
    "Details": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Details" } },
      "ja": { "stringUnit": { "state": "translated", "value": "詳細" } }
    } },
    "Enter a sample rate from 1 to 4294967295 Hz (no grouping).": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Enter a sample rate from 1 to 4294967295 Hz (no grouping)." } },
      "ja": { "stringUnit": { "state": "translated", "value": "サンプルレートは 1〜4294967295 Hz の整数で、桁区切りなしで入力してください。" } }
    } },
    "Enter a finite, nonnegative tail that fits in 4294967295 frames.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Enter a finite, nonnegative tail that fits in 4294967295 frames." } },
      "ja": { "stringUnit": { "state": "translated", "value": "余韻は 0 秒以上の有限値で、4294967295 フレームに収まる長さを入力してください。" } }
    } },
    "Enter a finite peak target from -120 to 0 dBFS.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Enter a finite peak target from -120 to 0 dBFS." } },
      "ja": { "stringUnit": { "state": "translated", "value": "ピーク目標は −120〜0 dBFS の有限値を入力してください。" } }
    } },
    "TPDF dither requires an integer PCM format.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "TPDF dither requires an integer PCM format." } },
      "ja": { "stringUnit": { "state": "translated", "value": "TPDF ディザには整数 PCM 形式を選んでください。" } }
    } },
    "Export Audio": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export Audio" } },
      "ja": { "stringUnit": { "state": "translated", "value": "音声を書き出す" } }
    } },
    "Whole song · Stereo WAV · Recorded mix and effects": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Whole song · Stereo WAV · Recorded mix and effects" } },
      "ja": { "stringUnit": { "state": "translated", "value": "曲全体・ステレオ WAV・確定済みのミックスと FX" } }
    } },
    "Format": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Format" } },
      "ja": { "stringUnit": { "state": "translated", "value": "形式" } }
    } },
    "WAV · 24-bit PCM": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "WAV · 24-bit PCM" } },
      "ja": { "stringUnit": { "state": "translated", "value": "WAV・24 bit PCM" } }
    } },
    "WAV · 16-bit PCM": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "WAV · 16-bit PCM" } },
      "ja": { "stringUnit": { "state": "translated", "value": "WAV・16 bit PCM" } }
    } },
    "WAV · 32-bit Float": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "WAV · 32-bit Float" } },
      "ja": { "stringUnit": { "state": "translated", "value": "WAV・32 bit 浮動小数点" } }
    } },
    "Sample rate (Hz)": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Sample rate (Hz)" } },
      "ja": { "stringUnit": { "state": "translated", "value": "サンプルレート（Hz）" } }
    } },
    "Use plugin tail length": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Use plugin tail length" } },
      "ja": { "stringUnit": { "state": "translated", "value": "プラグインの余韻の長さを使う" } }
    } },
    "Tail (seconds)": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Tail (seconds)" } },
      "ja": { "stringUnit": { "state": "translated", "value": "余韻（秒）" } }
    } },
    "TPDF dither": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "TPDF dither" } },
      "ja": { "stringUnit": { "state": "translated", "value": "TPDF ディザ" } }
    } },
    "Normalize sample peak": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Normalize sample peak" } },
      "ja": { "stringUnit": { "state": "translated", "value": "サンプルピークをノーマライズ" } }
    } },
    "Peak target (dBFS, −120…0)": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Peak target (dBFS, −120…0)" } },
      "ja": { "stringUnit": { "state": "translated", "value": "ピーク目標（dBFS、−120〜0）" } }
    } },
    "Export uses a private snapshot. Editing and playback can continue after preparation.": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export uses a private snapshot. Editing and playback can continue after preparation." } },
      "ja": { "stringUnit": { "state": "translated", "value": "専用のスナップショットから書き出します。準備後は編集と再生を続けられます。" } }
    } },
    "Choose an output outside the project package": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Choose an output outside the project package" } },
      "ja": { "stringUnit": { "state": "translated", "value": "プロジェクトの外に書出し先を選んでください" } }
    } },
    "Loading export settings": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Loading export settings" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出し設定を読込み中" } }
    } },
    "Preparing export": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Preparing export" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しを準備中" } }
    } },
    "Exporting audio": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Exporting audio" } },
      "ja": { "stringUnit": { "state": "translated", "value": "音声を書出し中" } }
    } },
    "Finalizing export": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Finalizing export" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しを仕上げ中" } }
    } },
    "Export progress": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export progress" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しの進捗" } }
    } },
    "Show in Finder": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Show in Finder" } },
      "ja": { "stringUnit": { "state": "translated", "value": "Finder で表示" } }
    } },
    "Export complete": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export complete" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しが完了しました" } }
    } },
    "Cancel export": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Cancel export" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しを取り消す" } }
    } },
    "Cancelling export": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Cancelling export" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しを取消中" } }
    } },
    "Export cancelled": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export cancelled" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しを取り消しました" } }
    } },
    "Export failed": { "localizations": {
      "en": { "stringUnit": { "state": "translated", "value": "Export failed" } },
      "ja": { "stringUnit": { "state": "translated", "value": "書出しに失敗しました" } }
    } },
    "Select a non-silent track to adjust the group's relative volume, or select this track alone.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Select a non-silent track to adjust the group's relative volume, or select this track alone." } },
        "ja": { "stringUnit": { "state": "translated", "value": "相対音量の調整は無音でないトラックを基準にするか、このトラックだけを選択してください。" } }
      }
    },
    "Volume and pan controls adjust selected tracks relatively, including header drags and resets.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Volume and pan controls adjust selected tracks relatively, including header drags and resets." } },
        "ja": { "stringUnit": { "state": "translated", "value": "音量とパンは、ヘッダのドラッグ・既定値リセットも含めて選択トラックを相対調整します。" } }
      }
    },
    "The latest saved version could not be read": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The latest saved version could not be read" } },
        "ja": { "stringUnit": { "state": "translated", "value": "最新の保存版を読み込めませんでした" } }
      }
    },
    "An older version was recovered. Recent edits may be missing. Cancel and preserve a copy of the project before continuing. Continuing saves the recovered version as a new checkpoint.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An older version was recovered. Recent edits may be missing. Cancel and preserve a copy of the project before continuing. Continuing saves the recovered version as a new checkpoint." } },
        "ja": { "stringUnit": { "state": "translated", "value": "古い保存版から復旧しました。最近の編集が失われている可能性があります。いったんキャンセルして、続行する前にプロジェクトのコピーを保全してください。続行すると復旧した状態を新しい保存点として保存します。" } }
      }
    },
    "Continue from recovered version": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Continue from recovered version" } },
        "ja": { "stringUnit": { "state": "translated", "value": "復旧した版から続行" } }
      }
    },
    "Cancel": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cancel" } },
        "ja": { "stringUnit": { "state": "translated", "value": "キャンセル" } }
      }
    },
    "Unreadable version": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unreadable version" } },
        "ja": { "stringUnit": { "state": "translated", "value": "読み込めない保存版" } }
      }
    },
    "Recovered version": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Recovered version" } },
        "ja": { "stringUnit": { "state": "translated", "value": "復旧元の保存版" } }
      }
    },
    "Applied journal sequence": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Applied journal sequence" } },
        "ja": { "stringUnit": { "state": "translated", "value": "復旧済みジャーナル連番" } }
