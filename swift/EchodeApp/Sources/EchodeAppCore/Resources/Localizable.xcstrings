    "Piano gesture help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click empty space to insert · Drag notes to move · Drag edges to resize"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白をダブルクリックして挿入 · ノートをドラッグして移動 · 端をドラッグして長さ変更"
          }
        }
      }
    },
    "Piano keyboard help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab / Shift-Tab: next / previous note. Arrows: pitch / time. Shift + left / right: length. Return: insert. Delete: remove. Escape: cancel drag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab / Shift-Tab: 次 / 前のノート。矢印: 音高 / 時間を変更。Shift と左右: 長さ変更。Return: 挿入。Delete: 削除。Escape: ドラッグをキャンセル。"
          }
        }
      }
    },
