    "Piano gesture help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to insert with remembered length · Drag empty space to draw a note · Right-drag to select notes · Command-click to toggle selection · Delete to remove selection · Drag selected notes to move them together · Drag edges to resize · Drag lower lane bars or Option-drag notes vertically for velocity"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックで記憶した長さを入力 · 空白をドラッグしてノート追加 · 右ドラッグで枠選択 · Command＋クリックで選択切替 · Delete で選択全体を削除 · 選択済みノートのドラッグで一括移動 · 端をドラッグして長さ変更 · 下部の棒またはノートの Option＋上下ドラッグでベロシティ変更"
          }
        }
      }
    },
    "Piano keyboard help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab / Shift-Tab: next / previous note. Arrows: pitch / time. Shift + left / right: length. Return: pause / resume. Delete: remove selected notes. Escape: cancel drag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab / Shift-Tab: 次 / 前のノート。矢印: 音高 / 時間を変更。Shift と左右: 長さ変更。Return: 一時停止・再開。Delete: 選択ノートを一括削除。Escape: ドラッグをキャンセル。"
          }
        }
      }
    },
