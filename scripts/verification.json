{
  "version": 1,
  "global_inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "rustfmt.toml", "clippy.toml", "deny.toml"],
  "infrastructure": ["Makefile", "justfile", "scripts/**", ".cursor/hooks*", ".cursor/hooks/**", ".github/workflows/**"],
  "areas": {
    "bridge": ["spikes/bridge/**", "crates/echode-model/**"],
    "audio": ["crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-sandbox/**"],
    "isolation": ["crates/echode-plugin-host/**", "crates/echode-test-plugin/**", "crates/echode-sandbox/**", "crates/echode-realtime/**", "crates/echode-engine/**"],
    "drawing": ["crates/echode-draw/**", "spikes/draw/**", "crates/echode-model/**"],
    "history": ["crates/echode-history/**", "crates/echode-model/**", "crates/echode-actions/**"],
    "input": ["spikes/input/**"],
    "render": ["crates/echode-cli/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-history/**"],
    "dependencies": ["Cargo.toml", "Cargo.lock", "deny.toml", "crates/*/Cargo.toml", "spikes/*/Cargo.toml"]
  },
  "checks": [
    {"id": "check", "mode": "automatic", "always": true, "areas": [], "timeout": 1200, "purpose": "通常の Rust / Swift、所有権の操作列、基準音声、保存形式、lint、FFI、ライセンス"},
    {"id": "rtsan", "mode": "automatic", "areas": ["audio"], "timeout": 600, "purpose": "テスト用シンセと実行計画の受け渡しでリアルタイム処理の禁止操作を検出"},
    {"id": "check-input", "mode": "automatic", "areas": ["input"], "timeout": 600, "purpose": "入力の Swift 単体テスト。確認ウィンドウは開かない"},
    {"id": "check-bridge-features", "mode": "automatic", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しの全 feature の Rust テストと lint、生成器を含むライセンス"},
    {"id": "check-bridge-asan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust の C ABI と Swift の往復を別プロセスでメモリ検査"},
    {"id": "check-bridge-tsan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust と Swift の橋渡しを同じプロセスで競合検査"},
    {"id": "check-bridge-miri", "mode": "automatic", "areas": ["bridge"], "timeout": 1800, "purpose": "橋渡しの Rust 側のポインタと所有権を解釈実行で検査"},
    {"id": "spike-isolation", "mode": "manual", "areas": ["isolation"], "timeout": 900, "purpose": "プラグイン隔離の release 計測。S3 の結果も更新する"},
    {"id": "spike-draw", "mode": "manual", "areas": ["drawing"], "timeout": 900, "purpose": "Metal の描画と可視判定を実機で計測"},
    {"id": "spike-history", "mode": "manual", "areas": ["history"], "timeout": 900, "purpose": "大きいプロジェクトの保存と復元を release で計測"},
    {"id": "spike-input", "mode": "manual", "areas": ["input"], "timeout": 900, "purpose": "確認ウィンドウでピンチ、触覚、感圧を確認し、ウィンドウを閉じる"},
    {"id": "spike-engine", "mode": "manual", "areas": ["audio"], "timeout": 1800, "purpose": "音声デバイスを使うエンジンの 10 分間の計測"},
    {"id": "spike-bridge", "mode": "manual", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しと配列の受け渡しを release で計測"},
    {"id": "spike-render", "mode": "manual", "areas": ["render"], "timeout": 900, "purpose": "WAV の一括書き出しを release で計測"},
    {"id": "advisories", "mode": "manual", "areas": ["dependencies"], "timeout": 600, "purpose": "ネットワークを使う依存ライブラリの脆弱性情報の検査"}
  ]
}
