    "product_audio": ["crates/echode-sine-pad/**", "crates/echode-audio-io/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift", "swift/EchodeBridge/Sources/EchodeBridge/Device.swift", "swift/EchodeApp/Sources/EchodeAppCore/DeviceParameters.swift"]
  },
  "checks": [
    {"id": "check-verification", "mode": "automatic", "always": true, "areas": [], "inputs": ["**"], "timeout": 180, "purpose": "検査の選択・結果再利用・診断・エージェント入口と原文読込・署名・ドキュメントの整合。製品のビルドとは別に記録"},
    {"id": "check", "make_target": "check-base", "mode": "automatic", "always": true, "areas": [], "timeout": 1200, "purpose": "通常の Rust / Swift、所有権の操作列、基準音声、保存形式、lint、FFI、ライセンス。製品契約は別の結果として記録", "packages": [], "inputs": ["crates/**", "spikes/**", "swift/**", "scripts/**", "Packaging/**", "project.yml", "LICENSE*"]},
    {"id": "check-product-contracts", "mode": "automatic", "always": true, "areas": [], "timeout": 900, "purpose": "実バンドル、初回位置、キー転送、ステレオ、ループ継ぎ目、フェーダー、準備中の停止、ペイン境界、MCPの実CLI編集を検査し、必須テストの削除・無視・0件実行も拒否する", "packages": ["echode-ffi", "echode-plugin-host", "echode-test-plugin", "echode-sine-pad", "echode-cli"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "scripts/check_product_contracts.py", "scripts/build-bundled-plugins.sh", "Packaging/EchodeSinePad-Info.plist"], "policy_inputs": ["product_contracts"]},
    {"id": "rtsan", "mode": "automatic", "areas": ["audio"], "timeout": 600, "purpose": "テスト用シンセ、計画の受け渡し、製品の再生と出力バッファ、プラグインヘルパーの処理区間でリアルタイム処理の禁止操作を検出", "packages": ["echode-engine", "echode-audio-io", "echode-plugin-host", "echode-test-plugin", "echode-sine-pad"], "inputs": ["scripts/build-bundled-plugins.sh", "Packaging/EchodeSinePad-Info.plist"]},
    {"id": "check-input", "mode": "automatic", "areas": ["input"], "timeout": 600, "purpose": "入力の Swift 単体テスト。確認ウィンドウは開かない", "packages": [], "inputs": ["spikes/input/**"]},
    {"id": "check-bridge-features", "mode": "automatic", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しの全 feature の Rust テストと lint、生成器を含むライセンス", "packages": ["echode-bridge-spike"], "inputs": []},
    {"id": "check-bridge-asan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust の C ABI と Swift の往復を別プロセスでメモリ検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "spikes/bridge/**", "scripts/check*bridge*", "scripts/run-bridge-validation.py", "scripts/bridge-toolchain.env", "scripts/tsan_runtime.py"]},
    {"id": "check-tsan-runtime", "mode": "automatic", "areas": ["bridge"], "timeout": 240, "purpose": "Darwin errno の寿命追跡と同じ errno への実競合の検出を検証", "inputs": ["scripts/tsan_runtime.py", "scripts/check-tsan-runtime.sh", "scripts/run-bridge-validation.py", "spikes/bridge/sanitizers/Errno.c", "spikes/bridge/sanitizers/darwin-tsan.patch"], "tool_inputs": ["target/toolchains/tsan/manifest.json", "target/toolchains/tsan/fixed/libclang_rt.tsan_osx_dynamic.dylib", "target/toolchains/tsan/baseline/libclang_rt.tsan_osx_dynamic.dylib"]},
    {"id": "check-bridge-tsan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust と Swift の橋渡しを同じプロセスで競合検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "spikes/bridge/**", "scripts/check*bridge*", "scripts/run-bridge-validation.py", "scripts/bridge-toolchain.env", "scripts/tsan_runtime.py"], "tool_inputs": ["target/toolchains/tsan/manifest.json", "target/toolchains/tsan/fixed/libclang_rt.tsan_osx_dynamic.dylib", "target/toolchains/tsan/baseline/libclang_rt.tsan_osx_dynamic.dylib"]},
    {"id": "check-bridge-miri", "mode": "automatic", "areas": ["bridge"], "timeout": 1800, "purpose": "橋渡しの Rust 側のポインタと所有権を解釈実行で検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["scripts/check-bridge-miri.sh", "scripts/bridge-toolchain.env", "scripts/run-bridge-validation.py"]},
    {"id": "spike-isolation", "mode": "manual", "areas": ["isolation"], "timeout": 900, "purpose": "プラグイン隔離の release 計測。S3 の結果も更新する", "packages": ["echode-plugin-host", "echode-test-plugin", "echode-sine-pad"], "inputs": ["scripts/build-bundled-plugins.sh", "Packaging/EchodeSinePad-Info.plist"], "device_context": true},
    {"id": "spike-draw", "mode": "manual", "areas": ["drawing"], "timeout": 900, "purpose": "Metal の描画と可視判定を実機で計測", "packages": ["echode-draw"], "inputs": ["spikes/draw/**"]},
    {"id": "spike-arrange-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、スクロール・ズーム・幅変更の左右の行境界と文字を比較", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "spike-piano-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、鍵盤・度数の行位置と、調に依存しない鍵盤・背景を比較", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "spike-history", "mode": "manual", "areas": ["history"], "timeout": 900, "purpose": "大きいプロジェクトの保存と復元、および無関係なノートが増えてもゲイン差分が軽いことの release 計測", "packages": ["echode-history", "echode-model"], "inputs": []},
    {"id": "spike-input", "mode": "manual", "areas": ["input"], "timeout": 900, "purpose": "確認ウィンドウでピンチ、触覚、感圧を確認し、ウィンドウを閉じる", "packages": [], "inputs": ["spikes/input/**"]},
    {"id": "spike-engine-smoke", "mode": "manual", "areas": ["audio"], "packages": ["echode-engine"], "inputs": [], "timeout": 180, "purpose": "通常の音声変更で行う10秒間の実機確認。10分間の安定性の証明とは区別する", "device_context": true},
    {"id": "spike-engine", "mode": "manual", "areas": ["audio"], "timeout": 1800, "purpose": "明示実行・全体確認用の10分間連続音声計測とrelease性能計測。通常の修正では要求しない", "packages": ["echode-engine"], "inputs": [], "extended": true, "device_context": true},
    {"id": "spike-audio", "mode": "manual", "areas": ["product_audio"], "timeout": 600, "purpose": "製品の CoreAudio 出力を無音で開き、コールバックと繰り返す停止・再起動を実機で検査。画面は開かない", "packages": ["echode-audio-io", "echode-plugin-host", "echode-test-plugin", "echode-sine-pad"], "inputs": [], "device_context": true},
    {"id": "spike-bridge", "mode": "manual", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しと配列の受け渡しを release で計測", "packages": ["echode-bridge-spike"], "inputs": ["spikes/bridge/**", "scripts/spike-bridge.sh", "scripts/run-bridge-validation.py"]},
    {"id": "spike-render", "mode": "manual", "areas": ["render"], "timeout": 900, "purpose": "WAV の一括書き出しを release で計測", "packages": ["echode-cli"], "inputs": []},
    {"id": "spike-app", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "製品のアレンジとピアノロールがメインスレッドの負荷中も描画することを実機で計測", "packages": ["echode-ffi", "echode-plugin-host"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "scripts/build-app.sh", "scripts/build-bundled-plugins.sh", "scripts/distribution.py", "scripts/diagnose.py", "Packaging/**"]},
    {"id": "spike-playhead", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "実ウインドウでプレイヘッドの位置移動・再生継続・一時停止・破棄・文書交換を確認する。通常検査には入れない", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "advisories", "mode": "manual", "areas": ["dependencies"], "timeout": 600, "purpose": "ネットワークを使う依存ライブラリの脆弱性情報の検査", "packages": ["*"], "inputs": ["deny.toml"]}
  ],
  "product_contracts": [
    {"id": "folder-disclosure-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "FolderDisclosureTests", "test": "contractFolderDisclosureKeepsHeadersAndLanesOnTheSameVisibleTracks", "timeout": 180, "purpose": "実ヘッダの開閉とShift選択から可視行・ミックス値・FXドロップ先・折りたたみ時の挿入と保存を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangePaneView.swift", "old": "headers.onToggleFolder = { [weak self] in self?.toggleFolder($0) }", "new": "headers.onToggleFolder = { _ in }"}},
    {"id": "folder-projection-ownership", "runner": "rust", "package": "echode-ffi", "target": ["--lib"], "test": "snapshot_ownership::contract_arrange_projection_retains_hierarchy_rows_and_controls_after_source_release", "timeout": 180, "purpose": "製品ABIの表示用スナップショットで元ハンドル解放後の階層・行・ミックス値・容量境界と再展開を確認", "negative_control": {"file": "crates/echode-ffi/src/queue.rs", "old": ".visit_visible_rows(&self.project, view, rows, emit);", "new": ".visit_visible(&self.project, view, { let _ = rows; emit });"}},
    {"id": "track-duplicate-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "TrackDuplicationTests", "test": "contractHeaderMenuDuplicatesSelectedSubtreesAsOneUndoAndReopen", "timeout": 180, "purpose": "実ヘッダの右メニューから選択部分木を各元の直後へ複製し、子孫の二重複製なし・音源とノートの独立・単一Undo/Redo・保存再読込を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/TrackDuplication.swift", "old": "if selectedTracks.contains(current) { return false }", "new": "if selectedTracks.contains(current) { return true }"}},
    {"id": "track-duplicate-model", "runner": "rust", "package": "echode-history", "target": ["--test", "track_duplication"], "test": "folder_copy_keeps_its_subtree_chain_and_clips_and_survives_history_and_reopen", "timeout": 180, "purpose": "フォルダ部分木の複製で順序・親子・FX状態・ミキサー値・独立した中身と内部リンクを保ち、Undo/Redo・ジャーナル・保存を確認", "negative_control": {"file": "crates/echode-model/src/duplicate.rs", "old": "clip.content = match copied_contents.get(&clip.content) {", "new": "clip.content = match Some(&clip.content) {"}},
    {"id": "track-insertion-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "TrackInsertionTests", "test": "contractCommandAndFooterInsertTracksAsOneUndoAndReopen", "timeout": 180, "purpose": "コマンドと末尾追加の共通経路で操作時の対象・空チェイン・単一Undo/Redo・保存再読込を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/TrackInsertion.swift", "old": "after: atEnd ? nil : selection,", "new": "after: nil,"}},
    {"id": "track-insertion-order", "runner": "rust", "package": "echode-history", "target": ["--test", "track_insertion"], "test": "positioned_tracks_preserve_sibling_keys_and_survive_history_and_reopen", "timeout": 180, "purpose": "フォルダ内末尾・部分木の外側・兄弟間挿入で既存キーを保ち、Undo/Redo・ジャーナル・保存を確認", "negative_control": {"file": "crates/echode-model/src/model.rs", "old": "if into_folder && self.tracks.iter().any(|track| track.parent == Some(after)) {", "new": "if false && into_folder && self.tracks.iter().any(|track| track.parent == Some(after)) {"}},
    {"id": "explicit-sine-pad", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "sine_pad"], "test": "contract_sine_pad_is_an_explicit_isolated_instrument_under_rtsan", "timeout": 240, "purpose": "同梱 Sine Pad の実 CLAP バンドルを走査し、通常の隔離・発音・バイパス・削除を確認", "negative_control": {"file": "crates/echode-engine/src/plugins.rs", "old": "plugin: Some(route.path.as_path()),", "new": "plugin: None,"}},
    {"id": "no-implicit-instrument", "runner": "rust", "package": "echode-engine", "target": ["--test", "product_playback"], "test": "notes_without_an_instrument_do_not_create_an_implicit_synth", "timeout": 240, "purpose": "音源を持たないノート入りトラックへ暗黙の音声を足さないことを製品再生で確認", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "plane.copy_from_slice(clip_plane);", "new": "plane.fill(0.25);"}},
    {"id": "sample-library-search", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleBrowserTests", "test": "contractRegisteredSampleSearchCoversAllRootsAndSkipsPackagesAndLinks", "timeout": 180, "purpose": "登録した全サンプルフォルダの再帰検索・重複排除・登録復元・解除・読込失敗を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/FileBrowserState.swift", "old": "searchingLibrary ? libraryFiles : files", "new": "files"}},
    {"id": "sample-import-target", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleBrowserTests", "test": "contractSampleInsertionCapturesItsTargetAndSurvivesUndoAndReopen", "timeout": 180, "purpose": "ブラウザの共通配置操作でトラック・ライブ位置・文書を保持し、単一 Undo・保存・古い対象の拒否を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/AudioImportRequest.swift", "old": "\"track\": request.track.uuidString", "new": "\"track\": (selection ?? request.track).uuidString"}},
    {"id": "sample-audition", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "audition::tests::contract_selected_sample_is_heard_raw_once_and_the_newest_selection_wins_under_rtsan", "timeout": 180, "purpose": "選択した素材を素の音で先頭から1回だけ鳴らし、新しい選択は先頭から・前の音は5msで減衰、停止・読めない素材・連続選択で最新だけを鳴らすことを製品の試聴スレッドとコールバックで確認", "negative_control": {"file": "crates/echode-engine/src/audition.rs", "old": "let gain = stop_gain(self.age, fade_frames);", "new": "let gain = 0.0 * stop_gain(self.age, fade_frames);"}},
    {"id": "sample-audition-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleBrowserTests", "test": "contractBrowserSelectionAuditionsOnlySamplesWithoutTheEditQueue", "timeout": 180, "purpose": "ブラウザの選択が音声素材だけを編集待ち行列を通さずに試聴し、フォルダ・プロジェクト・非音声・選択解除で停止し、文書なしでは鳴らさないことを確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/SampleAudition.swift", "old": "let sample = file.flatMap { $0.audio ? $0.url : nil }", "new": "let sample = file?.url"}},
    {"id": "sample-browser-click-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleBrowserTests", "test": "contractBrowserClickSelectsAndFocusesAtOnceAndOpensOnlyOnDoubleClick", "timeout": 180, "purpose": "ブラウザの一覧の単クリックが押した時点で選択・フォーカス移動・試聴要求1回を行い、ダブルクリックとReturnだけが配置し、ブラウザ自身の選択の付け替えでは試聴しないことを実際の表とイベントで確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/WorkspaceFileList.swift", "old": "if selectedRow != row { selectRowIndexes([row], byExtendingSelection: false) }", "new": "if selectedRow != row, event.clickCount > 1 { selectRowIndexes([row], byExtendingSelection: false) }"}},
    {"id": "sample-browser-content-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleBrowserContentTests", "test": "contractBrowserShowsProductionFilesAndMarksMIDIUnavailable", "timeout": 180, "purpose": "制作向けのフォルダ・音声・プロジェクト・MIDIだけを表示し、MIDIの未対応表示と音声だけの標準URLドラッグ元を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/FileBrowserState.swift", "old": "return file.visible ? file : nil", "new": "return file"}},
