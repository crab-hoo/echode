{
  "version": 1,
  "global_inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "rustfmt.toml", "clippy.toml", "deny.toml"],
  "infrastructure": ["Makefile", "justfile", "scripts/**", ".cursor/hooks*", ".cursor/hooks/**", ".codex/hooks*", ".codex/hooks/**", ".github/workflows/**"],
  "areas": {
    "bridge": ["spikes/bridge/**", "crates/echode-model/**", "crates/echode-ffi/**", "crates/echode-audio-io/**", "swift/EchodeBridge/**", "swift/EchodeApp/**"],
    "audio": ["crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-sandbox/**", "crates/echode-audio-io/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift"],
    "isolation": ["crates/echode-plugin-host/**", "crates/echode-test-plugin/**", "crates/echode-sandbox/**", "crates/echode-realtime/**", "crates/echode-engine/**"],
    "drawing": ["crates/echode-draw/**", "spikes/draw/**", "crates/echode-model/**", "swift/EchodeApp/Sources/EchodeAppCore/Arrange*.swift", "swift/EchodeApp/Sources/EchodeAppCore/Workspace*.swift", "swift/EchodeApp/Sources/EchodeAppCore/Canvas*.swift", "swift/EchodeApp/Sources/EchodeAppCore/FrameFeedbackGate.swift", "swift/EchodeApp/Sources/EchodeAppCore/FrameSlots.swift", "swift/EchodeApp/Sources/EchodeAppCore/Piano*.swift"],
    "history": ["crates/echode-history/**", "crates/echode-model/**", "crates/echode-actions/**"],
    "input": ["spikes/input/**"],
    "render": ["crates/echode-cli/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-history/**"],
    "dependencies": ["Cargo.toml", "Cargo.lock", "deny.toml", "crates/*/Cargo.toml", "spikes/*/Cargo.toml"],
    "app_drawing": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "crates/echode-ffi/**", "crates/echode-draw/**", "crates/echode-model/**"],
    "product_audio": ["crates/echode-audio-io/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift"]
  },
  "checks": [
    {"id": "check", "make_target": "check-base", "mode": "automatic", "always": true, "areas": [], "timeout": 1200, "purpose": "通常の Rust / Swift、所有権の操作列、基準音声、保存形式、lint、FFI、ライセンス。製品契約は別の結果として記録"},
    {"id": "check-product-contracts", "mode": "automatic", "always": true, "areas": [], "timeout": 900, "purpose": "実バンドルのスキャンから再生、最初の音声処理前の位置、ネイティブキー転送を検査し、必須テストの削除・無視・0件実行も拒否する"},
    {"id": "rtsan", "mode": "automatic", "areas": ["audio"], "timeout": 600, "purpose": "テスト用シンセ、計画の受け渡し、製品の再生と出力バッファ、プラグインヘルパーの処理区間でリアルタイム処理の禁止操作を検出"},
    {"id": "check-input", "mode": "automatic", "areas": ["input"], "timeout": 600, "purpose": "入力の Swift 単体テスト。確認ウィンドウは開かない"},
    {"id": "check-bridge-features", "mode": "automatic", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しの全 feature の Rust テストと lint、生成器を含むライセンス"},
    {"id": "check-bridge-asan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust の C ABI と Swift の往復を別プロセスでメモリ検査"},
    {"id": "check-bridge-tsan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust と Swift の橋渡しを同じプロセスで競合検査"},
    {"id": "check-bridge-miri", "mode": "automatic", "areas": ["bridge"], "timeout": 1800, "purpose": "橋渡しの Rust 側のポインタと所有権を解釈実行で検査"},
    {"id": "spike-isolation", "mode": "manual", "areas": ["isolation"], "timeout": 900, "purpose": "プラグイン隔離の release 計測。S3 の結果も更新する"},
    {"id": "spike-draw", "mode": "manual", "areas": ["drawing"], "timeout": 900, "purpose": "Metal の描画と可視判定を実機で計測"},
    {"id": "spike-arrange-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、スクロール・ズーム・幅変更の左右の行境界と文字を比較"},
    {"id": "spike-piano-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、鍵盤・度数の行位置と、調に依存しない鍵盤・背景を比較"},
    {"id": "spike-history", "mode": "manual", "areas": ["history"], "timeout": 900, "purpose": "大きいプロジェクトの保存と復元、および無関係なノートが増えてもゲイン差分が軽いことの release 計測"},
    {"id": "spike-input", "mode": "manual", "areas": ["input"], "timeout": 900, "purpose": "確認ウィンドウでピンチ、触覚、感圧を確認し、ウィンドウを閉じる"},
    {"id": "spike-engine", "mode": "manual", "areas": ["audio"], "timeout": 1800, "purpose": "音声デバイスを使うエンジンの 10 分間の計測と、逆順イベント整列の release 計測"},
    {"id": "spike-audio", "mode": "manual", "areas": ["product_audio"], "timeout": 600, "purpose": "製品の CoreAudio 出力を無音で開き、コールバックと繰り返す停止・再起動を実機で検査。画面は開かない"},
    {"id": "spike-bridge", "mode": "manual", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しと配列の受け渡しを release で計測"},
    {"id": "spike-render", "mode": "manual", "areas": ["render"], "timeout": 900, "purpose": "WAV の一括書き出しを release で計測"},
    {"id": "spike-app", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "製品のアレンジとピアノロールがメインスレッドの負荷中も描画することを実機で計測"},
    {"id": "spike-playhead", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "実ウインドウでプレイヘッドの位置移動・再生継続・一時停止・破棄・文書交換を確認する。通常検査には入れない"},
    {"id": "advisories", "mode": "manual", "areas": ["dependencies"], "timeout": 600, "purpose": "ネットワークを使う依存ライブラリの脆弱性情報の検査"}
  ],
  "product_contracts": [
    {"id": "startup-position", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "stream::tests::contract_startup_position_is_published_before_the_first_callback", "timeout": 240, "purpose": "HALに登録する製品と同じ準備経路で、初回コールバック前の位置と初回出力後を確認", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "Box::new(InternalClock { position: sample })", "new": "Box::<InternalClock>::default()"}},
    {"id": "macos-plugin-bundle", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_macos_bundle_scan_to_playback_and_load_errors", "timeout": 240, "purpose": "macOSバンドルを別プロセスでスキャンし、キャッシュからの楽器・エフェクト処理と読み込み失敗を確認", "negative_control": {"file": "crates/echode-engine/src/plugins.rs", "old": "if !route.path.exists() {", "new": "if !route.path.is_file() {"}},
    {"id": "header-key-routing", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "InputRoutingTests", "test": "contractHeaderForwardsSpaceAndUnownedKeys", "timeout": 240, "purpose": "実際のNSView.keyDownへキーイベントを渡し、Spaceと未処理キーが上位へ一度届くことを確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangeHeaderView.swift", "old": "default: super.keyDown(with: event)", "new": "default: interpretKeyEvents([event])"}}
  ]
}
