{
  "version": 1,
  "global_inputs": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "rustfmt.toml", "clippy.toml", "deny.toml"],
  "infrastructure": ["Makefile", "justfile", "scripts/**", ".cursor/hooks*", ".cursor/hooks/**", ".codex/hooks*", ".codex/hooks/**", ".github/workflows/**"],
  "evidence_inputs": ["Makefile", "scripts/verify.py", ".cargo/**"],
  "areas": {
    "bridge": ["spikes/bridge/**", "crates/echode-model/**", "crates/echode-ffi/**", "crates/echode-audio-io/**", "swift/EchodeBridge/**", "swift/EchodeApp/**"],
    "audio": ["crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-sandbox/**", "crates/echode-audio-io/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift"],
    "isolation": ["crates/echode-plugin-host/**", "crates/echode-test-plugin/**", "crates/echode-sandbox/**", "crates/echode-realtime/**", "crates/echode-engine/**"],
    "drawing": ["crates/echode-draw/**", "spikes/draw/**", "crates/echode-model/**", "swift/EchodeApp/Sources/EchodeAppCore/Arrange*.swift", "swift/EchodeApp/Sources/EchodeAppCore/Workspace*.swift", "swift/EchodeApp/Sources/EchodeAppCore/Canvas*.swift", "swift/EchodeApp/Sources/EchodeAppCore/Mix*.swift", "swift/EchodeApp/Sources/EchodeAppCore/FrameFeedbackGate.swift", "swift/EchodeApp/Sources/EchodeAppCore/FrameSlots.swift", "swift/EchodeApp/Sources/EchodeAppCore/Piano*.swift"],
    "history": ["crates/echode-history/**", "crates/echode-model/**", "crates/echode-actions/**"],
    "input": ["spikes/input/**"],
    "render": ["crates/echode-cli/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-history/**"],
    "dependencies": ["Cargo.toml", "Cargo.lock", "deny.toml", "crates/*/Cargo.toml", "spikes/*/Cargo.toml"],
    "app_drawing": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "crates/echode-ffi/**", "crates/echode-draw/**", "crates/echode-model/**"],
    "product_audio": ["crates/echode-audio-io/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift"]
  },
  "checks": [
    {"id": "check-verification", "mode": "automatic", "always": true, "areas": [], "inputs": ["**"], "timeout": 180, "purpose": "検査の選択・結果再利用・診断・署名・ドキュメントの整合。製品のビルドとは別に記録"},
    {"id": "check", "make_target": "check-base", "mode": "automatic", "always": true, "areas": [], "timeout": 1200, "purpose": "通常の Rust / Swift、所有権の操作列、基準音声、保存形式、lint、FFI、ライセンス。製品契約は別の結果として記録", "packages": [], "inputs": ["crates/**", "spikes/**", "swift/**", "scripts/**", "Packaging/**", "project.yml", "LICENSE*"]},
    {"id": "check-product-contracts", "mode": "automatic", "always": true, "areas": [], "timeout": 900, "purpose": "実バンドル、初回位置、キー転送、ステレオ、ループ継ぎ目、フェーダー、準備中の停止、ペイン境界を検査し、必須テストの削除・無視・0件実行も拒否する", "packages": ["echode-ffi", "echode-plugin-host", "echode-test-plugin"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "scripts/check_product_contracts.py"], "policy_inputs": ["product_contracts"]},
    {"id": "rtsan", "mode": "automatic", "areas": ["audio"], "timeout": 600, "purpose": "テスト用シンセ、計画の受け渡し、製品の再生と出力バッファ、プラグインヘルパーの処理区間でリアルタイム処理の禁止操作を検出", "packages": ["echode-engine", "echode-audio-io", "echode-plugin-host", "echode-test-plugin"], "inputs": []},
    {"id": "check-input", "mode": "automatic", "areas": ["input"], "timeout": 600, "purpose": "入力の Swift 単体テスト。確認ウィンドウは開かない", "packages": [], "inputs": ["spikes/input/**"]},
    {"id": "check-bridge-features", "mode": "automatic", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しの全 feature の Rust テストと lint、生成器を含むライセンス", "packages": ["echode-bridge-spike"], "inputs": []},
    {"id": "check-bridge-asan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust の C ABI と Swift の往復を別プロセスでメモリ検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "spikes/bridge/**", "scripts/check*bridge*", "scripts/run-bridge-validation.py", "scripts/bridge-toolchain.env"]},
    {"id": "check-bridge-tsan", "mode": "automatic", "areas": ["bridge"], "timeout": 1200, "purpose": "Rust と Swift の橋渡しを同じプロセスで競合検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "spikes/bridge/**", "scripts/check*bridge*", "scripts/run-bridge-validation.py", "scripts/bridge-toolchain.env"]},
    {"id": "check-bridge-miri", "mode": "automatic", "areas": ["bridge"], "timeout": 1800, "purpose": "橋渡しの Rust 側のポインタと所有権を解釈実行で検査", "packages": ["echode-ffi", "echode-bridge-spike"], "inputs": ["scripts/check-bridge-miri.sh", "scripts/bridge-toolchain.env", "scripts/run-bridge-validation.py"]},
    {"id": "spike-isolation", "mode": "manual", "areas": ["isolation"], "timeout": 900, "purpose": "プラグイン隔離の release 計測。S3 の結果も更新する", "packages": ["echode-plugin-host", "echode-test-plugin"], "inputs": [], "device_context": true},
    {"id": "spike-draw", "mode": "manual", "areas": ["drawing"], "timeout": 900, "purpose": "Metal の描画と可視判定を実機で計測", "packages": ["echode-draw"], "inputs": ["spikes/draw/**"]},
    {"id": "spike-arrange-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、スクロール・ズーム・幅変更の左右の行境界と文字を比較", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "spike-piano-frame", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "画面を開かず製品の Metal 描画を読み戻し、鍵盤・度数の行位置と、調に依存しない鍵盤・背景を比較", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "spike-history", "mode": "manual", "areas": ["history"], "timeout": 900, "purpose": "大きいプロジェクトの保存と復元、および無関係なノートが増えてもゲイン差分が軽いことの release 計測", "packages": ["echode-history", "echode-model"], "inputs": []},
    {"id": "spike-input", "mode": "manual", "areas": ["input"], "timeout": 900, "purpose": "確認ウィンドウでピンチ、触覚、感圧を確認し、ウィンドウを閉じる", "packages": [], "inputs": ["spikes/input/**"]},
    {"id": "spike-engine-smoke", "mode": "manual", "areas": ["audio"], "packages": ["echode-engine"], "inputs": [], "timeout": 180, "purpose": "通常の音声変更で行う10秒間の実機確認。10分間の安定性の証明とは区別する", "device_context": true},
    {"id": "spike-engine", "mode": "manual", "areas": ["audio"], "timeout": 1800, "purpose": "明示実行・全体確認用の10分間連続音声計測とrelease性能計測。通常の修正では要求しない", "packages": ["echode-engine"], "inputs": [], "extended": true, "device_context": true},
    {"id": "spike-audio", "mode": "manual", "areas": ["product_audio"], "timeout": 600, "purpose": "製品の CoreAudio 出力を無音で開き、コールバックと繰り返す停止・再起動を実機で検査。画面は開かない", "packages": ["echode-audio-io", "echode-plugin-host", "echode-test-plugin"], "inputs": [], "device_context": true},
    {"id": "spike-bridge", "mode": "manual", "areas": ["bridge"], "timeout": 900, "purpose": "橋渡しと配列の受け渡しを release で計測", "packages": ["echode-bridge-spike"], "inputs": ["spikes/bridge/**", "scripts/spike-bridge.sh", "scripts/run-bridge-validation.py"]},
    {"id": "spike-render", "mode": "manual", "areas": ["render"], "timeout": 900, "purpose": "WAV の一括書き出しを release で計測", "packages": ["echode-cli"], "inputs": []},
    {"id": "spike-app", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "製品のアレンジとピアノロールがメインスレッドの負荷中も描画することを実機で計測", "packages": ["echode-ffi", "echode-plugin-host"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**", "scripts/build-app.sh", "scripts/distribution.py", "scripts/diagnose.py", "Packaging/**"]},
    {"id": "spike-playhead", "mode": "manual", "areas": ["app_drawing"], "timeout": 600, "purpose": "実ウインドウでプレイヘッドの位置移動・再生継続・一時停止・破棄・文書交換を確認する。通常検査には入れない", "packages": ["echode-ffi"], "inputs": ["swift/EchodeApp/**", "swift/EchodeBridge/**"]},
    {"id": "advisories", "mode": "manual", "areas": ["dependencies"], "timeout": 600, "purpose": "ネットワークを使う依存ライブラリの脆弱性情報の検査", "packages": ["*"], "inputs": ["deny.toml"]}
  ],
  "product_contracts": [
    {"id": "startup-position", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "stream::tests::contract_startup_position_is_published_before_the_first_callback", "timeout": 240, "purpose": "HALに登録する製品と同じ準備経路で、初回コールバック前の位置と初回出力後を確認", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "Box::new(InternalClock { position: sample })", "new": "Box::<InternalClock>::default()"}},
    {"id": "macos-plugin-bundle", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_macos_bundle_scan_to_playback_and_load_errors", "timeout": 240, "purpose": "macOSバンドルを別プロセスでスキャンし、キャッシュからの楽器・エフェクト処理と読み込み失敗を確認", "negative_control": {"file": "crates/echode-engine/src/plugins.rs", "old": "if !route.path.exists() {", "new": "if !route.path.is_file() {"}},
    {"id": "header-key-routing", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "InputRoutingTests", "test": "contractHeaderForwardsSpaceAndUnownedKeys", "timeout": 240, "purpose": "実際のNSView.keyDownへキーイベントを渡し、Spaceと未処理キーが上位へ一度届くことを確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangeHeaderView.swift", "old": "default: super.keyDown(with: event)", "new": "default: interpretKeyEvents([event])"}},
    {"id": "stereo-media", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "clips::tests::contract_imported_stereo_survives_trim_gain_resampling_playback_and_export", "timeout": 240, "purpose": "実WAVを取り込み、トリム・ゲイン・SRCを通った逆位相の左右が再生と書き出しで残ることを確認", "negative_control": {"file": "crates/echode-audio-io/src/clips.rs", "old": "let right = if pcm.channels == 2 {", "new": "let right = if pcm.channels == 1 {"}},
    {"id": "stereo-plugin-chain", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_stereo_planes_survive_effects_and_instrument_injection", "timeout": 240, "purpose": "別プロセスのエフェクト間と楽器出力への素材の合成で左右の位相と振幅を維持", "negative_control": {"file": "crates/echode-engine/src/plugins.rs", "old": "right: (main == 2).then(|| source.output[1].as_slice()),", "new": "right: None,"}},
    {"id": "audio-loop-seam", "runner": "rust", "package": "echode-engine", "target": ["--test", "block_size"], "test": "product_audio_loop_fades_follow_project_positions_across_blocks", "timeout": 240, "purpose": "製品の配置音声でループ継ぎ目の振幅とブロック長からの独立性を確認", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "crate::voice::fade_loop_seam(&played, fade, output)?;", "new": "crate::voice::fade_loop_seam(&played, 0, output)?;"}},
    {"id": "audio-fader-ramp", "runner": "rust", "package": "echode-engine", "target": ["--test", "block_size"], "test": "fader_edits_ramp_without_restarting_on_unrelated_replacement", "timeout": 240, "purpose": "ゲイン・パン・ミュートの標本単位の補間と計画交換時の値の継続を確認", "negative_control": {"file": "crates/echode-engine/src/mix.rs", "old": "frames: fader_ramp_frames(rate),", "new": "frames: 1,"}},
    {"id": "engine-measurement-completion", "runner": "rust", "package": "echode-engine", "target": ["--lib"], "test": "device::tests::contract_engine_measurement_requires_progress_and_completion", "timeout": 240, "purpose": "実機計測と同じ制御ループで、途中停止・機器変更・中断・空の計測を合格にしない", "negative_control": {"file": "crates/echode-engine/src/device.rs", "old": "self.outcome == MeasurementEnd::Completed", "new": "true"}},
    {"id": "pane-boundary", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "CanvasBoundaryTests", "test": "contractShrinkingPanesClipThePreviousSurfaceBeforeChildLayout", "timeout": 240, "purpose": "ペイン縮小と子のレイアウトがずれた瞬間にも描画を境界内へ制限", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangePaneView.swift", "old": "clipsToBounds = true", "new": "clipsToBounds = false"}},
    {"id": "pending-transport", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "TransportRequestTests", "test": "contractStopAndSpaceRemainAvailableWhilePlayIsPreparing", "timeout": 240, "purpose": "再生準備の応答を保留しても停止とSpaceが届き、古い応答が停止を上書きしない", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift", "old": "!audioBusy || command.playbackIntent != nil", "new": "!audioBusy"}},
    {"id": "transport-cancellation", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "stream::tests::contract_stop_during_preparation_gates_callbacks_under_rtsan", "timeout": 240, "purpose": "準備中の停止は初回発音を禁止し、既発音の停止は5ms以内の補正だけを残して時計を止める", "negative_control": {"file": "crates/echode-audio-io/src/transport.rs", "old": "self.0.load(Ordering::Acquire) == revision", "new": "{ let _ = revision; true }"}},
    {"id": "queued-stop", "runner": "rust", "package": "echode-ffi", "target": ["--lib"], "test": "queue::tests::contract_stop_submission_invalidates_queued_play_before_worker_receives_it", "timeout": 240, "purpose": "製品ABIの投入経路で、文書ワーカーが停止を受け取る前に古い再生を無効にする", "negative_control": {"file": "crates/echode-ffi/src/queue.rs", "old": "self.cancellation.request(&command)", "new": "TransportCancellation::default().request(&command)"}},
    {"id": "plugin-transport-reset", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_stop_seek_resume_does_not_replay_plugin_tails", "timeout": 240, "purpose": "残響を持つ楽器・エフェクト・連鎖で停止と位置移動後の旧音を排除し、自然な余韻と重なるノートは維持する", "negative_control": {"file": "crates/echode-plugin-host/src/threads.rs", "old": "active.reset();", "new": "let _ = command;"}},
    {"id": "plugin-midi-panic", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_midi_lifecycle_stops_all_declared_ports", "timeout": 240, "purpose": "標準リセットを無視するプラグインでも宣言した全MIDI入力の発音を止め、通常の余韻は保つ", "negative_control": {"file": "crates/echode-plugin-host/src/threads.rs", "old": "buffers.events.push(event);", "new": "let _ = event;"}},
    {"id": "plugin-state-poll", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_preparing_a_graph_keeps_current_audio_running_under_rtsan", "timeout": 240, "purpose": "状態確認・グラフ準備中も既存のプラグイン音声と時計が連続し、音声側の所有権を制御側に渡さない", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "self.loop_start = self.current.loop_start;", "new": "if self.status.requested_plan.load(Ordering::Acquire) != self.status.applied_plan.load(Ordering::Acquire) { return Ok(()); }\n        self.loop_start = self.current.loop_start;"}},
    {"id": "transport-declick", "runner": "rust", "package": "echode-audio-io", "target": ["--lib"], "test": "stream::tests::contract_stop_preserves_waveform_while_fading_under_rtsan", "timeout": 240, "purpose": "停止・一時停止・取消で位相の違う実波形を5ms減衰し、時計停止とブロック長からの独立性を確認", "negative_control": {"file": "crates/echode-audio-io/src/stream.rs", "old": "state.declick.process_stop(left, right, offset);", "new": "state.declick.process(left, right, true);"}},
    {"id": "stop-cleanup", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_live_stop_cleanup_never_waits_for_a_reset", "timeout": 240, "purpose": "停止後の破棄する処理でリセット完了を待たず、保留中は時計と新規発音を進めず完了後に再開する", "negative_control": {"file": "crates/echode-engine/src/playback.rs", "old": "let cleanup_deadline = if live { None } else { Some(deadline) };", "new": "let cleanup_deadline = Some(deadline);"}},
    {"id": "plugin-onset", "runner": "rust", "package": "echode-plugin-host", "target": ["--test", "hosted_playback"], "test": "contract_plugin_note_onsets_preserve_source_samples_under_rtsan", "timeout": 240, "purpose": "無音からの自然な発音・再発音で、イベント時刻とステレオ波形がプラグイン単体と一致し、ブロック分割でも変わらないことを確認", "negative_control": {"file": "crates/echode-plugin-host/src/events.rs", "old": "buffer.push(&NoteOnEvent::new(\n                    note.time,", "new": "buffer.push(&NoteOnEvent::new(\n                    0,"}},
    {"id": "track-mix-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "MixControlTests", "test": "contractHeaderMixerGesturesPersistOnceAndUndo", "timeout": 240, "purpose": "ヘッダの実マウス入力から音量・パン・ミュート・ソロを変更し、ドラッグ1回のUndoと保存・再読込を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangeHeaderView.swift", "old": "mixActions.set(id, field, mix[field].value == 0 ? 1 : 0)", "new": "mixActions.set(id, field, mix[field].value)"}},
    {"id": "clip-mix-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "MixControlTests", "test": "contractClipHandlesPersistGainAndFadesInDocumentTime", "timeout": 240, "purpose": "クリップの実ドラッグからゲインと両端フェードを変更し、時間単位・Undo・保存を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangeView.swift", "old": "clipDraft = draft; refresh()", "new": "clipDraft = nil; refresh()"}},
    {"id": "live-mix-meter", "runner": "rust", "package": "echode-engine", "target": ["--test", "block_size"], "test": "contract_live_fader_preview_and_peak_taps_under_rtsan", "timeout": 240, "purpose": "ライブの試聴・確定・取消と計画交換で音を保持し、フェーダー後の実ピークと停止中の減衰を確認", "negative_control": {"file": "crates/echode-engine/src/mix.rs", "old": "peak = peak.max(l.abs()).max(r.abs());", "new": "peak = 0.0;"}}
  ]
}
