    "audio": ["crates/echode-sine-pad/**", "crates/echode-engine/**", "crates/echode-realtime/**", "crates/echode-model/**", "crates/echode-sandbox/**", "crates/echode-audio-io/**", "crates/echode-ffi/**", "swift/EchodeBridge/Sources/EchodeBridge/Audio.swift", "swift/EchodeBridge/Sources/EchodeBridge/Document.swift", "swift/EchodeApp/Sources/EchodeAppCore/ProjectController.swift", "swift/EchodeBridge/Sources/EchodeBridge/Device.swift", "swift/EchodeApp/Sources/EchodeAppCore/DeviceParameters.swift", "crates/echode-plugin-host/src/threads.rs", "crates/echode-plugin-host/src/relay.rs", "crates/echode-plugin-host/tests/hosted_playback.rs", "crates/echode-plugin-host/tests/hosted_playback/**"],
