    {"id": "sample-drop-entry-ui", "runner": "swift", "package_path": "swift/EchodeApp", "suite": "SampleAudioDropTests", "test": "nativeDropEntryRejectsDocumentChangesAndCancelledDrags", "timeout": 180, "purpose": "AppKitの実ドロップ入口でcopyの受理・確定と取消・文書交換・move専用ドラッグの拒否を確認", "negative_control": {"file": "swift/EchodeApp/Sources/EchodeAppCore/ArrangeView.swift", "old": "audioDragDocument = audioDocument", "new": "audioDragDocument = nil"}},
