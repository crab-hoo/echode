{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Shell|Write|StrReplace|Delete|EditNotebook|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/wait-for-verify.sh\"",
            "timeout": 15600
          }
        ]
      }
    ]
  }
}
